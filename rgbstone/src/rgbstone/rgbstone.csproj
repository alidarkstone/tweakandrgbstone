<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8.1 is part of Windows 10/11: the result is one small exe with no runtime to install. -->
    <TargetFramework>net481</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <StartupObject>RgbStone.Program</StartupObject>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>RgbStone</RootNamespace>
    <AssemblyName>rgbstone</AssemblyName>
    <ApplicationIcon>..\..\assets\rgbstone.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.4.0</Version>
    <Product>rgbstone</Product>
    <Company>darkstone</Company>
    <Copyright>darkstone</Copyright>
    <Description>rgbstone - portable RGB controller</Description>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Runtime.Serialization" />
    <EmbeddedResource Include="..\..\assets\rgbstone.ico" LogicalName="rgbstone.ico" />
    <EmbeddedResource Include="..\..\assets\logo-64.png" LogicalName="logo-64.png" />
    <EmbeddedResource Include="Web\dashboard.html" LogicalName="dashboard.html" />
    <None Remove="Web\dashboard.html" />
  </ItemGroup>

</Project>
